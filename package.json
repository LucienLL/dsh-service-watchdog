{
  "name": "dsh-service-watchdog",
  "version": "0.2.2",
  "description": "DeepSeek Harness plugin: restart the DSH web service from the main UI with a second confirmation when agent sessions are active, a live running/stopped status, a detached self-healing watchdog, and optional login autostart",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "restart",
    "watchdog",
    "service"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucienLL/dsh-service-watchdog.git"
  },
  "homepage": "https://github.com/LucienLL/dsh-service-watchdog#readme",
  "bugs": {
    "url": "https://github.com/LucienLL/dsh-service-watchdog/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.6 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.6 || 0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || 0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-plugins": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
